<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Appenders>
		<Console name="Console">
			<PatternLayout pattern="%d{ISO8601} %X{sessionId} %X{flowId} %-5level %logger{1.}.%method(%line) - %m%n" />
		</Console>
	</Appenders>
	<Loggers>
		<Logger name="com.testrigor" level="debug" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<Root level="warn">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>
