<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.testrigor</groupId>
		<artifactId>selenium-extension</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>

	<artifactId>manual-tests</artifactId>
	<packaging>jar</packaging>
	<name>${project.parent.groupId}:${project.artifactId}</name>
	<description>Manual real-server tests for selenium extension</description>

	<properties>
		<manualTests.skip>true</manualTests.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.testrigor</groupId>
			<artifactId>selenium-extension-4</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.typesafe</groupId>
			<artifactId>config</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- selenium-4 main classes may be JaCoCo offline-instrumented; agent RT jar is required at test runtime -->
		<dependency>
			<groupId>org.jacoco</groupId>
			<artifactId>org.jacoco.agent</artifactId>
			<classifier>runtime</classifier>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>${manualTests.skip}</skipTests>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
